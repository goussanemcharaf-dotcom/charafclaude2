 "phrases": [
  {
   "id": 1,
   "section": "hook",
   "text": "Vous investissez dans la publicité sur Facebook ou Instagram…",
   "start": 0.12,
   "end": 3.401,
   "take": "s1_b"
  },
  {
   "id": 2,
   "section": "question",
   "text": "Mais est-ce que votre budget vous apporte vraiment des clients ?",
   "start": 3.741,
   "end": 6.964,
   "take": "s1q_b"
  },
  {
   "id": 3,
   "section": "problem",
   "text": "Lancer une campagne Meta Ads, ce n’est pas simplement créer une vidéo, choisir un bouton et appuyer sur « Publier ».",
   "start": 7.914,
   "end": 16.261,
   "take": "s2_b"
  },
  {
   "id": 4,
   "section": "business",
   "text": "Avant de dépenser votre budget publicitaire, il faut comprendre votre business.",
   "start": 16.811,
   "end": 21.597,
   "take": "s3_a"
  },
  {
   "id": 5,
   "section": "business",
   "text": "Votre offre.",
   "start": 21.997,
   "end": 22.801,
   "take": "s3_a"
  },
  {
   "id": 6,
   "section": "business",
   "text": "Votre marché.",
   "start": 23.021,
   "end": 24.04,
   "take": "s3_a"
  },
  {
   "id": 7,
   "section": "business",
   "text": "Votre client idéal.",
   "start": 24.26,
   "end": 25.919,
   "take": "s3_a"
  },
  {
   "id": 8,
   "section": "business",
   "text": "Ses besoins, ses frustrations et ses motivations.",
   "start": 26.219,
   "end": 29.458,
   "take": "s3_a"
  },
  {
   "id": 9,
   "section": "eskayli",
   "text": "Chez Eskayli DZ, nous construisons votre stratégie Meta Ads autour de votre business.",
   "start": 30.008,
   "end": 34.952,
   "take": "s4_c"
  },
  {
   "id": 10,
   "section": "system",
   "text": "Nous travaillons le bon angle.",
   "start": 35.402,
   "end": 36.991,
   "take": "s4_a"
  },
  {
   "id": 11,
   "section": "system",
   "text": "Le bon message.",
   "start": 37.211,
   "end": 38.38,
   "take": "s4_a"
  },
  {
   "id": 12,
   "section": "system",
   "text": "La bonne créative.",
   "start": 38.6,
   "end": 39.882,
   "take": "s4_a"
  },
  {
   "id": 13,
   "section": "system",
