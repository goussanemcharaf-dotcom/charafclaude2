   "start": 40.102,
   "end": 41.414,
   "take": "s4_b"
  },
  {
   "id": 14,
   "section": "testing",
   "text": "Puis nous lançons, testons et optimisons vos campagnes Facebook & Instagram Ads.",
   "start": 41.914,
   "end": 47.272,
   "take": "s5_c"
  },
  {
   "id": 15,
   "section": "outcome",
