 "phrases": [
  {
   "id": 1,
   "text": "Si tu es UGC Creator,",
   "src": [
    0,
    1.51
   ],
   "start": 0.08,
   "end": 1.59
  },
  {
   "id": 2,
   "text": "Content Creator,",
   "src": [
    1.63,
    2.605
   ],
   "start": 1.65,
   "end": 2.625
  },
  {
   "id": 3,
   "text": "Voice Over Artist ou Influenceur…",
   "src": [
    2.725,
    4.64
   ],
   "start": 2.685,
   "end": 4.6
  },
  {
   "id": 4,
   "text": "et que tu envoies encore ton travail entre Google Drive, WhatsApp et plusieurs liens…",
   "src": [
    4.76,
    8.4
   ],
   "start": 4.66,
   "end": 8.3
  },
  {
   "id": 5,
   "text": "Une vidéo ici.",
   "src": [
    8.52,
    9.415
   ],
   "start": 8.4,
   "end": 9.295
  },
  {
   "id": 6,
   "text": "Un fichier là.",
   "src": [
    9.535,
    10.28
   ],
   "start": 9.355,
   "end": 10.1
  },
  {
   "id": 7,
   "text": "Un autre lien ailleurs.",
   "src": [
    10.4,
    11.4
   ],
   "start": 10.16,
   "end": 11.16
  },
  {
   "id": 8,
   "text": "Et ton client doit chercher partout pour comprendre qui tu es et ce que tu fais ?",
   "src": [
    11.52,
    14.57
   ],
   "start": 11.22,
   "end": 14.27
  },
  {
   "id": 9,
   "text": "Non.",
   "src": [
    14.69,
    15.13
   ],
   "start": 14.49,
   "end": 14.93
  },
  {
   "id": 10,
   "text": "Ton travail mérite une meilleure présentation.",
   "src": [
    15.25,
    17.255
   ],
   "start": 15.65,
   "end": 17.655
  },
  {
   "id": 11,
   "text": "Je crée pour toi un Premium Website Portfolio, pensé autour de ton univers.",
   "src": [
    17.375,
    20.97
   ],
   "start": 17.935,
   "end": 21.53
  },
  {
   "id": 12,
   "text": "Tes projets, tes services, ton style… réunis dans une seule expérience.",
   "src": [
    21.09,
    25.325
   ],
   "start": 21.75,
   "end": 25.985
  },
  {
   "id": 13,
   "text": "Au lieu d'envoyer dix liens…",
   "src": [
    25.445,
    26.775
   ],
   "start": 26.285,
   "end": 27.615
  },
  {
   "id": 14,
   "text": "tu envoies un seul lien.",
   "src": [
    26.895,
    28.135
   ],
   "start": 27.935,
   "end": 29.175
  },
  {
   "id": 15,
   "text": "Ton client clique.",
   "src": [
    28.255,
    28.985
   ],
   "start": 29.535,
   "end": 30.265
  },
  {
   "id": 16,
   "text": "Et découvre un portfolio professionnel, clair et différent.",
   "src": [
    29.105,
    32.44
   ],
   "start": 30.385,
   "end": 33.72
  },
  {
   "id": 17,
   "text": "Écris-moi et on commence.",
